poke {g_n+0} 0 w1
poke {g_n+1} 0 w1
poke {g_n+2} 0 w1
waituntil wave == 10 30 w1
expect boss_wave == 1 w1
expect boss_st == 1 w1
expect boss_lv == 1 w1
expect boss_hp == 24 w1
expect groups_left == 0 w1
run 60
screenshot shots/b0_intro.ppm
waituntil phase == 1 200 w1
poke lives 5 w1
echo [2] it closes in and holds its distance
poke invuln 250 w1
waituntil boss_rel <= 160 600 w1
poke invuln 250 w1
run 120
expect boss_rel >= 110 w1
expect boss_rel <= 170 w1
screenshot shots/b1_fight.ppm
echo [3] it fires spreads and launches escorts
poke invuln 250 w1
waituntil en_count >= 8 700 w1
poke invuln 250 w1
echo [4] frame rate during the fight (tapping fire, weaving), then the autopilot wears it down
