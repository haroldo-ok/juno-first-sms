symbols junofirst.noi
echo [1] wave 10 is a boss wave
run 60
tap 1
waituntil phase == 1 300 w1
poke wave 9 w1
poke groups_left 0 w1
poke {en+0} 0 w1
poke {en+14} 0 w1
poke {en+28} 0 w1
poke {en+42} 0 w1
poke {en+56} 0 w1
poke {en+70} 0 w1
