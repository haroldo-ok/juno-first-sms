symbols junofirst.noi

echo [1] boot to title
run 90
expectvdp display 1
expect game_state == 0 w1
expectcolors 6
screenshot shots/00_title.ppm

echo [2] start game: two formations of 8 already inbound
tap 1
waituntil game_state == 1 60 w1
expect lives == 3 w1
expect wave == 1 w1
expect en_count == 16 w1
run 60
screenshot shots/01_intro.ppm
waituntil phase == 1 200 w1

echo [3] shoot a diver coming straight at us, it bursts into particles
poke cam_z 0
poke pvz 0
poke px 128 w1
poke pxf 0x8000
poke {en+4} 1 w1
poke n_div 1 w1
poke {div_idx+0} 0 w1
poke {en+1} 1 w1
poke {en+5} 128 w1
poke {en+10} 1920
poke {score+1} 0 w1
poke {score+2} 9 w1
poke {score+3} 9 w1
poke {score+4} 9 w1
poke lives 3 w1
hold 1
waituntil {score+5} >= 5 60 w1
echo     ... and crossing 100,000 awards a ship
expect {score+1} == 1 w1
expect lives == 4 w1
poke lives 3 w1
hold none
expect {bu_t+0} > 0 w1
run 6
screenshot shots/02_particles.ppm

echo [4] inertia: the ship coasts
poke invuln 250 w1
hold up
run 30
expect pvz >= 40 s16
hold none
run 60
expect pvz >= 30 s16
hold down
run 50
expect pvz < 0 s16
hold left
run 20
expect px < 100 w1
hold none

echo [5] full formations, frame rate holds under load
poke invuln 250 w1
poke loops 0
hold up+1
run 300
expect loops >= 296
hold none
poke invuln 250 w1
screenshot shots/03_action.ppm

echo [6] astronaut pickup -> red bonus field
poke invuln 250 w1
poke cam_z 0
poke px 128 w1
poke pxf 0x8000
poke pvz 0
poke as_x 128 w1
poke as_z 0x01E0
poke as_st 1 w1
waituntil bonus_timer > 0 60
expect bonus_val >= 2 w1
run 30
screenshot shots/04_bonus.ppm

echo [7] warp
poke invuln 250 w1
tap 2
waituntil warps == 0 10 w1
waituntil pstate == 0 60 w1

echo [8] ship explosion fills the screen, then game over
poke lives 1 w1
poke invuln 0 w1
poke cam_z 0
poke pvz 0
poke px 128 w1
poke pxf 0x8000
poke {en+14} 1 w1
poke {en+18} 1 w1
poke n_div 1 w1
poke {div_idx+0} 1 w1
poke {en+19} 128 w1
poke {en+24} 0x01C0
waituntil pstate == 1 30 w1
run 26
screenshot shots/05_death_a.ppm
run 14
screenshot shots/05_death_b.ppm
waituntil game_state == 2 200 w1
run 30
screenshot shots/06_over.ppm
waituntil game_state == 0 400 w1
run 40
expectvdp display 1
screenshot shots/07_title2.ppm
